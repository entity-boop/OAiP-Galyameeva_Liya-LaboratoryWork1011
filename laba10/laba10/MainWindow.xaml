<Window x:Class="laba10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="550" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="Регистрация" FontSize="22" FontWeight="SemiBold" 
                   HorizontalAlignment="Center" Margin="0,0,0,18"/>

        <!-- ФИО -->
        <Label Grid.Row="1" Grid.Column="0" Content="ФИО:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtFIO" Height="30" Margin="0,0,0,6"/>

        <!-- Email -->
        <Label Grid.Row="2" Grid.Column="0" Content="Email:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtEmail" Height="30" Margin="0,0,0,6"/>

        <!-- Телефон -->
        <Label Grid.Row="3" Grid.Column="0" Content="Телефон:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtPhone" Height="30" Margin="0,0,0,6"/>

        <!-- Направление -->
        <Label Grid.Row="4" Grid.Column="0" Content="Направление:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CbDirection" Height="30" Margin="0,0,0,6">
            <ComboBoxItem Content="Портрет"/>
            <ComboBoxItem Content="Репортаж"/>
            <ComboBoxItem Content="Макросъемка"/>
            <ComboBoxItem Content="Пейзаж"/>
        </ComboBox>

        <!-- Дата первой публикации -->
        <Label Grid.Row="6" Grid.Column="0" Content="Дата публикации:" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="6" Grid.Column="1" x:Name="DpFirstPost" Height="30" Margin="0,0,0,6"/>

        <!-- Пароль -->
        <Label Grid.Row="7" Grid.Column="0" Content="Пароль:" VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="7" Grid.Column="1" x:Name="PbPassword" Height="30" Margin="0,0,0,6"/>

        <!-- Администратор -->
        <CheckBox Grid.Row="8" Grid.Column="1" x:Name="IsAdmin" 
                  Content="Администратор" Margin="0,0,0,10"/>

        <!-- Кнопка регистрации -->
        <Button Grid.Row="9" Grid.ColumnSpan="2" Content="Зарегистрироваться" 
                Height="36" Width="160" HorizontalAlignment="Center"
                FontSize="14" FontWeight="SemiBold"
                Click="BtnRegister_Click" Margin="0,0,0,10"/>

        <!-- Переход к авторизации -->
        <Button Grid.Row="10" Grid.ColumnSpan="2" Content="Есть аккаунт? Войти" 
                Height="28" Width="145" HorizontalAlignment="Center"
                FontSize="12" FontWeight="SemiBold"
                Background="Transparent" BorderThickness="0" Foreground="#0078D4"
                Click="BtnGoToAuth_Click"/>
    </Grid>
</Window>