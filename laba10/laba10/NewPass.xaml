<Window x:Class="laba10.NewPass"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Восстановление пароля" Height="480" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="Восстановление пароля" FontSize="22" FontWeight="SemiBold" 
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <!-- Email -->
        <Label Grid.Row="1" Grid.Column="0" Content="Email:" VerticalAlignment="Center" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtEmail3" Height="30" Margin="0,0,0,10"/>

        <!-- Кнопка Отправить код -->
        <Button Grid.Row="2" Grid.ColumnSpan="2" Content="Отправить код" 
                Height="34" Width="160" HorizontalAlignment="Center"
                Click="BtnSendCode_Click" Margin="0,0,0,14"/>

        <!-- Код -->
        <Label Grid.Row="3" Grid.Column="0" Content="Код:" VerticalAlignment="Center" Margin="0,0,0,4"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtCode" Height="30" Margin="0,0,0,10"/>

        <!-- Кнопка Проверить код -->
        <Button Grid.Row="4" Grid.ColumnSpan="2" Content="Проверить код" 
                Height="34" Width="160" HorizontalAlignment="Center"
                Click="BtnVerifyCode_Click" Margin="0,0,0,14"/>

        <!-- Новый пароль -->
        <Label Grid.Row="5" Grid.Column="0" Content="Новый пароль:" VerticalAlignment="Center" Margin="0,0,0,4"/>
        <PasswordBox Grid.Row="5" Grid.Column="1" x:Name="NewPassword" Height="30" Margin="0,0,0,10"/>

        <!-- Кнопка Сменить пароль -->
        <Button Grid.Row="6" Grid.ColumnSpan="2" Content="Сменить пароль" 
                Height="36" Width="160" HorizontalAlignment="Center"
                FontSize="14" FontWeight="SemiBold"
                Click="BtnChangePassword_Click" Margin="0,0,0,16"/>

        <!-- Ссылка Назад ко входу -->
        <Button Grid.Row="8" Grid.ColumnSpan="2" Content="Назад ко входу" 
                Height="30" Width="120" HorizontalAlignment="Center"
                Background="Transparent" BorderThickness="0" Foreground="#0078D4"
                FontWeight="Medium" Cursor="Hand"
                Click="BtnBackToLogin_Click"/>
    </Grid>
</Window>