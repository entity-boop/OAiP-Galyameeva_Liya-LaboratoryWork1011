<Window x:Class="laba10.Auth"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Войти в аккаунт" Height="400" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="Войти в аккаунт" FontSize="22" FontWeight="SemiBold" 
                   HorizontalAlignment="Center" Margin="0,0,0,18"/>

        <!-- Email -->
        <Label Grid.Row="2" Grid.Column="0" Content="Email:" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtEmail2" Height="30" Margin="0,0,0,6"/>

        <!-- Пароль -->
        <Label Grid.Row="3" Grid.Column="0" Content="Пароль:" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="Password2" Height="30" Margin="0,0,0,6"/>

        <!--  CheckBox Администратор  -->
        <CheckBox Grid.Row="4" Grid.Column="1" x:Name="ChkIsAdmin" 
                  Content="Войти как администратор" 
                  VerticalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Кнопка Войти -->
        <Button Grid.Row="5" Grid.ColumnSpan="2" Content="Войти" 
                Height="36" Width="160" HorizontalAlignment="Center"
                FontSize="14" FontWeight="SemiBold"
                Click="BtnIn_Click"/>

        <!-- Регистрация -->
        <Button Grid.Row="6" Grid.ColumnSpan="2" Content="Нет аккаунта? Регистрация" 
                Height="20" Width="160" HorizontalAlignment="Center"
                FontSize="12" FontWeight="SemiBold"
                Click="BtnGoToReg_Click"/>

        <!-- Забыли пароль? -->
        <Button Grid.Row="7" Grid.ColumnSpan="2" Content="Забыли пароль?" 
                Height="20" Width="160" HorizontalAlignment="Center"
                FontSize="12" FontWeight="SemiBold" Margin="0,-100,0,0"
                Background="Transparent" BorderThickness="0" Foreground="#0078D4"
                Click="BtnSetNewPas_Click"/>
    </Grid>
</Window>