<Window x:Class="laba10.adminInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель администратора" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Список пользователей" 
                   FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>

        <!-- Таблица пользователей -->
        <DataGrid Grid.Row="1" x:Name="UsersDataGrid" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Margin="0,0,0,20"
                  SelectionChanged="UsersDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FIO}" Width="150"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120"/>
                <DataGridTextColumn Header="Направление" Binding="{Binding Genre}" Width="120"/>
                <DataGridTextColumn Header="Дата публикации" Binding="{Binding DateOfFirstPost, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Поля для добавления/редактирования -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="ФИО:" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtFIO" Height="25" Margin="0,0,0,5"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Email:" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtEmail" Height="25" Margin="0,0,0,5"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Телефон:" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtPhone" Height="25" Margin="0,0,0,5"/>

            <Label Grid.Row="3" Grid.Column="0" Content="Направление:" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CbGenre" Height="25" Margin="0,0,0,5">
                <ComboBoxItem Content="Портрет"/>
                <ComboBoxItem Content="Репортаж"/>
                <ComboBoxItem Content="Макросъемка"/>
                <ComboBoxItem Content="Пейзаж"/>
            </ComboBox>

            <Label Grid.Row="4" Grid.Column="0" Content="Роль:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CbRole" Height="25" Margin="0,0,0,5">
                <ComboBoxItem Content="User"/>
                <ComboBoxItem Content="Admin"/>
            </ComboBox>

            <Label Grid.Row="5" Grid.Column="0" Content="Пароль:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <PasswordBox Grid.Row="5" Grid.Column="1" x:Name="AddPassword" Height="25" Margin="0,0,0,0"/>
        </Grid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Добавить" Width="120" Height="35" Margin="0,0,10,0"
                    Background="#90EE90" BorderThickness="0" FontWeight="SemiBold"
                    Click="BtnAdd_Click"/>

            <Button Content="Обновить" Width="120" Height="35" Margin="0,0,10,0"
                    Background="#FFA500" BorderThickness="0" FontWeight="SemiBold"
                    Click="BtnUpdate_Click"/>

            <Button Content="Удалить" Width="120" Height="35" Margin="0,0,10,0"
                    Background="#FF0000" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                    Click="BtnDelete_Click"/>

            <Button Content="Обновить список" Width="120" Height="35" Margin="10,0,0,0"
                    Background="#EE82EE" BorderThickness="0" FontWeight="SemiBold"
                    Click="BtnRefresh_Click"/>

            <Button Content="Выйти" Width="100" Height="35" Margin="20,0,0,0"
                    Background="#FF6347" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                    Click="BtnLogout_Click"/>
        </StackPanel>
    </Grid>
</Window>